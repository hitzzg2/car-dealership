# 生产环境配置示例
# 复制此文件为 .env 并填写实际值

NODE_ENV=production
PORT=3001
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/car-dealership
JWT_SECRET=your-super-secure-secret-key-minimum-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://www.autosks.com,https://admin.autosks.com
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800
